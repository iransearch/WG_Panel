# ── REQUIRED ─────────────────────────────────────────────────────────
FLASK_SECRET_KEY=                
FERNET_KEY=
API_KEY=
DATABASE_URL=postgresql+psycopg://wg_panel:CHANGE_ME@127.0.0.1:5432/wg_panel

# ── RECOMMENDED (prod) ───────────────────────────────────────────────
LOG_LEVEL=INFO                           
SECURE_COOKIES=0                          # 1 in HTTPS, 0 in dev
AMNEZIAWG_CONF_PATH=/etc/amnezia/amneziawg

# ── OPTIONAL / QUALITY-OF-LIFE ───────────────────────────────────────
SETUP_TOKEN=                              # if you want to gate /register
TG_HEARTBEAT_SEC=60                       # bot heartbeat window (default 60)
WG_ONLINE_PROBE_FIRST=1
WG_ONLINE_HANDSHAKE_FALLBACK=0
WG_ONLINE_HANDSHAKE_WINDOW=45
